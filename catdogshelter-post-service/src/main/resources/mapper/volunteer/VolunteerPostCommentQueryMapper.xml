<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backoven.catdogshelter.domain.volunteer.query.mapper.VolunteerPostCommentQueryMapper">

    <!-- 댓글 DTO 매핑 -->
    <resultMap id="VolunteerPostCommentMap" type="com.backoven.catdogshelter.domain.volunteer.query.dto.VolunteerPostCommentQueryDto">
        <id property="commentId" column="id"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="writerName" column="writer_name"/>
    </resultMap>

    <!-- 댓글 리스트 조회 (삭제X, 블라인드X) -->
    <select id="selectVolunteerPostCommentsByPostId" resultMap="VolunteerPostCommentMap">
        SELECT
            vpc.id,
            vpc.content,
            vpc.created_at,
            CASE
                WHEN vpc.user_id IS NOT NULL THEN u.user_name
                WHEN vpc.head_id IS NOT NULL THEN h.company_name
                ELSE '알 수 없음'
                END AS writer_name
        FROM volunteerPostComment vpc
                 LEFT JOIN user u ON vpc.user_id = u.user_id
                 LEFT JOIN shelter_head h ON vpc.head_id = h.head_id
        WHERE vpc.post_id = #{postId}
          AND vpc.is_deleted = FALSE
          AND vpc.is_blinded = FALSE
        ORDER BY vpc.created_at ASC
    </select>

</mapper>
